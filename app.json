{
  "expo": {
    "name": "TripCost",
    "slug": "tripcost",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tripcost",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0B0F14",
    "primaryColor": "#F5A524",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0B0F14",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripcost.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "TripCost uses the camera to photograph invoices, tow bills and receipts so their amounts can be read into your records.",
        "NSPhotoLibraryUsageDescription": "TripCost reads documents you select from your photo library to pull expense amounts into your records.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tripcost.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.CAMERA", "android.permission.INTERNET"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "TripCost reads documents you select to pull expense amounts into your records.",
          "cameraPermission": "TripCost uses the camera to photograph invoices and receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
