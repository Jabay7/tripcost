{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NWS_USER_AGENT": "TripCost-dev (you@example.com)"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_NWS_USER_AGENT": "TripCost (you@example.com)"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_NWS_USER_AGENT": "TripCost (you@example.com)"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
